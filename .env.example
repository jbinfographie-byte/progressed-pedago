# Secrets obligatoires - générer des valeurs uniques en production
MASTER_ENCRYPTION_KEY=
SECURITY_PEPPER=

# PostgreSQL (Supabase : utiliser de préférence le Session pooler sur Hostinger)
DATABASE_URL=
DATABASE_POOL_SIZE=10

# Stockage privé Supabase - clé serveur uniquement, jamais NEXT_PUBLIC_
SUPABASE_URL=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=progressed-pedago

# Initialisation du premier administrateur
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_BOOTSTRAP_TOKEN=

# Intelligence artificielle
OPENAI_MODEL=gpt-5.5
OPENAI_API_KEY=

# URL publique canonique
NEXT_PUBLIC_SITE_URL=https://votre-domaine.example

# Envoi d'e-mails
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Connexions externes facultatives
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
CANVA_CLIENT_ID=
CANVA_CLIENT_SECRET=
